# AgentTrace environment template.
#
# Copy to .env and fill in only the services you actually use. The app runs
# fine with everything blank: unconfigured tools degrade cleanly and the
# observer still works. All values are read once at startup.

# --- Supabase (data_lookup_report, research_and_email enrichment) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Comma-separated allowlist of tables the agent may touch. Leave EMPTY to
# disable the whitelist, or set e.g.:
SUPABASE_ALLOWED_TABLES=public_data

# --- Gmail (research_and_email, inbox_summarize) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Live test recipient (used only by the test suite):
GMAIL_TEST_TO=

# --- Observer API ---
# Flask debug on/off.
AGENTTRACE_DEBUG=false
# Paths (defaults shown; the app falls back to these when unset).
AGENTTRACE_DB_PATH=agenttrace.sqlite
AGENTTRACE_MEMORY_PATH=MEMORY.md
AGENTTRACE_MAX_STEPS=8
AGENTTRACE_TOOL_TIMEOUT_S=15
# Optional bearer token. When set, /api/v1/* requires
# `Authorization: Bearer <token>` (health and preflight stay open).
AGENTTRACE_API_TOKEN=
# Extra CORS origins (comma-separated), in addition to localhost:3000/3001.
AGENTTRACE_CORS_ORIGINS=
# Directory for memory snapshots (default: .snapshots next to the DB).
AGENTTRACE_SNAPSHOT_DIR=